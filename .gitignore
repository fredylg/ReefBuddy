# Dependencies
node_modules/

# Wrangler
.wrangler/
.dev.vars

# Environment
.env
.env.local
.env.*.local

# Build
dist/
.turbo/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store
*.xcuserstate

# Xcode user-specific files (BUT NEVER IGNORE project.pbxproj!)
iOS/ReefBuddy.xcodeproj/xcuserdata/
iOS/ReefBuddy.xcodeproj/project.xcworkspace/xcuserdata/

# ⚠️ CRITICAL: project.pbxproj must ALWAYS be tracked
# DO NOT add: iOS/ReefBuddy.xcodeproj/project.pbxproj
# DO NOT add: *.pbxproj
# These files are essential and must be in version control

# Logs
*.log
npm-debug.log*

# Testing
coverage/
.nyc_output/

# Claude Code: keep the shared agent definitions, ignore local settings
.claude/*
!.claude/agents/

# Security - Private keys (NEVER commit these!)
*.p8
AuthKey_*.p8

# Local D1 exports (never commit)
backups/

# Promo assets: videos and images stay out of git (tools/promo-recording regenerates them,
# originals are in the owner's ~/Documents backup). The scripts and text library are tracked.
docs/marketing/stories/
docs/marketing/app-store-screenshots/
docs/marketing/library/posts/*/images/
tools/promo-recording/uitest/ReefBuddyPromo.xcodeproj/
tools/promo-recording/photos/*.jpg
tools/promo-recording/seed-ids.json
