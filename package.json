{
  "name": "reefbuddy",
  "version": "1.0.8",
  "description": "High-contrast, New Brutalist iOS app for saltwater aquarium hobbyists",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "types": "wrangler types --strict-vars=false --env-interface Env",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run typecheck && npm run lint:migrations && npm test && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply reef-db --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply reef-db --remote",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "deploy:web": "wrangler pages deploy web --project-name reefbuddy-web --branch main --commit-dirty=true",
    "lint:migrations": "./scripts/lint-migrations.sh"
  },
  "keywords": [
    "cloudflare-workers",
    "aquarium",
    "reef",
    "water-chemistry"
  ],
  "author": "Fredy Lievano (Aethers)",
  "license": "UNLICENSED",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.5.4"
  },
  "private": true
}
